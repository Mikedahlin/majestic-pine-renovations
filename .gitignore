# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-audit/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.*.log
dev-server*.log
next-dev*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Local photo backups and superseded galleries
/public/basement-projects/
/public/jeremy-stoesz-old.png
/public/project-photos/original-service/

# Local lead storage
/data/leads/

# AI agent config files (not needed for the website)
/AGENTS.md
/CLAUDE.md

# GitHub Actions workflow (not needed for local build/deploy)
.github/

# Documentation (not needed for the website)
/README.md
