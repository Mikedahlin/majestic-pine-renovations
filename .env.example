# Site
NEXT_PUBLIC_SITE_URL=https://majesticpinerenovations.com

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_MODEL_ID=gemini

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.0-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini



# Lead / CRM integrations (configure in production — never commit secrets)
CRM_PROVIDER=hubspot

# HubSpot tracking (public — safe for browser)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# HubSpot server-side sync (Private App access token — never expose to client)
HUBSPOT_ACCESS_TOKEN=
# Legacy alias — HUBSPOT_API_KEY still works if set instead of HUBSPOT_ACCESS_TOKEN
HUBSPOT_API_KEY=

# Optional: submit leads through a HubSpot form (recommended for attribution)
# Find portal ID in HubSpot Settings → Account & Billing
# Find form GUID in Marketing → Forms → Share → embed code
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

DISPATCH_WEBHOOK_URL=
LEAD_NOTIFICATION_EMAIL=
SMS_PROVIDER=

